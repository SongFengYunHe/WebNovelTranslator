{
  "name": "web-novel-translator",
  "version": "3.0.1",
  "description": "A tray-driven web novel translator built with Electron and React (popup window + global hotkey).",
  "author": "Web Novel Translator",
  "license": "MIT",
  "main": "dist/main/main.js",
  "overrides": {
    "sharp": "0.33.5"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "smoke": "npm run build && SMOKE_TEST=1 electron .",
    "dist": "npm run build && electron-builder --config electron-builder.config.js",
    "dist:dir": "npm run build && electron-builder --config electron-builder.config.js --dir",
    "dist:ci": "electron-builder --config electron-builder.config.js --win --publish never"
  },
  "dependencies": {
    "better-sqlite3": "9.6.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "epub-gen": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@xenova/transformers": "^2.17.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5"
  }
}
